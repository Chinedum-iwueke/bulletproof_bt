  "title": "BTC liquidity-stress proxy reversal",
  "claim": "Does an extreme point-in-time BTCUSDT 5m absolute return per unit quote_volume predict opposite-direction close-to-close return over the next 30m?",
  "intuition": "An unusually large completed-bar displacement relative to observed quote volume can identify transient liquidity stress whose price effect subsequently decays.",
  "market_mechanism": "The ratio is a point-in-time liquidity-stress proxy, not evidence that observed trades caused market impact; reversal is tested against informed-flow continuation, volatility clustering, and a matched return-shock control.",
  "engine_strategy_name": "btc_5m_impact_proxy_reversal",
  "engine_hypothesis_template": "research/hypotheses/alpha_003_btc_5m_impact_proxy_reversal.yaml",
  "features": [
    {"id": "completed_5m_return", "source": "ohlcv", "source_field": "close", "transform": "return", "window": 1, "lag": 0},
    {"id": "completed_5m_quote_volume", "source": "research_panel", "source_field": "quote_volume", "transform": "identity", "window": 5, "lag": 0, "join": "backward"},
    {"id": "impact_proxy", "source": "derived", "transform": "identity", "inputs": ["completed_5m_return", "completed_5m_quote_volume"], "lag": 0},
    {"id": "impact_proxy_extremity", "source": "derived", "transform": "percentile_rank", "inputs": ["impact_proxy"], "lag": 1}
  ],
  "gates": [
    {"left": "completed_5m_quote_volume", "op": ">=", "right": 1000000.0},
    {"left": "impact_proxy_extremity", "op": ">=", "right_param": "impact_proxy_threshold"}
