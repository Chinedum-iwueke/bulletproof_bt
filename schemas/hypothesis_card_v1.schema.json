{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hypothesis_card_v1",
  "type": "object",
  "required": ["schema_version", "card_id", "program_id", "version", "status", "title", "claim", "intuition", "market_mechanism", "features", "gates", "entry", "exit", "sizing", "risk_controls", "parameters", "data_requirements", "logging_requirements", "evaluation", "falsification_criteria", "expected_failure_modes", "execution_semantics", "field_provenance"],
  "properties": {
    "schema_version": {"const": "hypothesis_card_v1"},
    "status": {"enum": ["draft", "confirmed", "superseded"]},
    "features": {"type": "array", "items": {"type": "object", "required": ["id", "source", "transform"]}},
    "gates": {"type": "array", "items": {"type": "object", "required": ["op"]}},
    "parameters": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1}},
    "data_requirements": {"type": "array", "items": {"type": "string"}},
    "execution_semantics": {"$ref": "#/$defs/truthSemantics"}
  },
  "$defs": {"truthSemantics": {"type": "object", "required": ["strict_utc", "missing_bars", "interpolation", "htf_completeness", "aux_join_direction", "execution_authority", "risk_authority", "accounting"], "properties": {"strict_utc": {"const": true}, "missing_bars": {"const": "no_decision"}, "interpolation": {"const": "forbidden"}, "htf_completeness": {"const": "closed_only"}, "aux_join_direction": {"const": "backward"}, "execution_authority": {"const": "engine"}, "risk_authority": {"const": "engine"}, "accounting": {"const": "engine_canonical_R"}}}}
}
