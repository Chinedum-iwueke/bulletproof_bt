{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invarianceresearch.xyz/schemas/immutable-dataset-snapshot-v1.schema.json",
  "title": "Immutable Dataset Snapshot",
  "type": "object",
  "required": ["schema_version", "identity", "dataset_family", "source", "market", "exchange", "timeframe", "knowledge_cutoff", "partitions", "clock", "availability_policy", "membership", "correction_policy", "corrections", "access_classification", "provenance", "manifest_digest"],
  "properties": {
    "schema_version": {"const": "immutable-dataset-snapshot-v1.0.0"},
    "identity": {"type": "object"},
    "dataset_family": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "market": {"enum": ["perp", "spot"]},
    "exchange": {"type": "string", "minLength": 1},
    "timeframe": {"type": "string", "minLength": 1},
    "knowledge_cutoff": {"type": "string", "format": "date-time"},
    "partitions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["relative_path", "content_digest", "byte_size", "row_count", "columns", "min_event_time", "max_event_time", "max_available_at", "quality"]}},
    "clock": {"type": "object", "required": ["timezone", "event_time_column", "timestamp_semantics"]},
    "availability_policy": {"type": "object", "required": ["kind", "available_at_column", "lag_seconds", "missing_observation_policy"]},
    "membership": {"type": "array"},
    "correction_policy": {"const": "append_only_successor"},
    "corrections": {"type": "array"},
    "access_classification": {"enum": ["public", "internal-research", "restricted", "licensed"]},
    "provenance": {"type": "object", "required": ["source_root_alias", "source_mutated"]},
    "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
