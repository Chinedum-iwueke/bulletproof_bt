{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invarianceresearch.xyz/schemas/market-model-bundle-v1.schema.json",
  "title": "Market Model Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "version", "models", "bundle_digest"],
  "properties": {
    "schema_version": {"const": "market-model-bundle-v1.0.0"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["schema_version", "model_id", "version", "kind", "support_status", "applicability", "timestamp_semantics", "parameters", "uncertainty", "stress_ranges", "calibration", "fallback", "incompatibilities", "unsupported_reason", "card_digest"]
      }
    },
    "bundle_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
